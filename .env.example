# 存储后端
# ---------------------------------------------------------------
# 默认：配置了 MYSQL_HOST 就走 MySQL，否则用本地 SQLite(.data/adh.sqlite)
# ADH_DB 可强制指定：sqlite | mysql
# ADH_DB=sqlite
#
# 文件默认：配置了 OSS 就同步到 OSS，否则只落本地 .data/
# ADH_STORAGE 可强制指定：local | oss
# ADH_STORAGE=local

# MySQL（可选）
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# 阿里云 OSS（可选）
# 文件同步到 bucket 的 adh/ 目录：
#   adh/packages/<sha256>.<apk|ipa>
#   adh/thumbnails/<deviceId>.jpg
#   adh/app-icons/<hash>.png
# 不配置时文件只落本地 .data/ 目录。
ADH_OSS_BUCKET=
# 也可以写 cn-shenzhen，会自动补成 oss-cn-shenzhen
ADH_OSS_REGION=oss-cn-shenzhen
# 自定义 endpoint，留空由 region 推导
ADH_OSS_ENDPOINT=
ADH_OSS_ACCESS_KEY_ID=
ADH_OSS_ACCESS_KEY_SECRET=
# 对象根目录，默认 adh
ADH_OSS_PREFIX=adh
# 绑定了自定义域名可填，用于生成直链
ADH_OSS_PUBLIC_BASE_URL=

# 服务端
# ADH_PORT=8080
# ADH_HOST=0.0.0.0
# ADH_DATA_DIR=.data
# ADH_LOG_LEVEL=info
# ADH_LOCAL_AGENT=1
# 部署到子路径，例如 /adh（默认根路径）。修改后页面、API、Agent 接入地址都带这个前缀
# ADH_BASE_PATH=/adh