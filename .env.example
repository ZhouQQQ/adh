# 阿里云 OSS（可选）
# 配置后安装包与设备缩略图会同步到 bucket 下的 adh/ 目录：
#   adh/packages/<sha256>.<apk|ipa>
#   adh/thumbnails/<deviceId>.jpg
#   adh/app-icons/<hash>.png
# 不配置时文件只落本地 .data/ 目录。
ADH_OSS_BUCKET=
ADH_OSS_REGION=oss-cn-hangzhou
# 自定义 endpoint，留空由 region 推导
ADH_OSS_ENDPOINT=
ADH_OSS_ACCESS_KEY_ID=
ADH_OSS_ACCESS_KEY_SECRET=
# 对象根目录，默认 adh
ADH_OSS_PREFIX=adh
# 绑定了自定义域名可填，用于生成直链
ADH_OSS_PUBLIC_BASE_URL=

# 服务端
# ADH_PORT=8080
# ADH_HOST=0.0.0.0
# ADH_DATA_DIR=.data
# ADH_LOG_LEVEL=info
# ADH_LOCAL_AGENT=1